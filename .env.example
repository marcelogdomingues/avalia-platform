# Copiar para .env e preencher.

# ── LLM (agnóstico de fornecedor, API compatível com OpenAI) ─────────────────
# POC (default): Groq — gratuito e rápido. Cria uma chave grátis em
#   https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
# Recomendado (maior certeza): modelo de raciocínio open-weight da OpenAI, 120B.
LLM_MODEL=openai/gpt-oss-120b
#   Alternativas grátis no Groq: qwen/qwen3-32b, meta-llama/llama-4-scout-17b-16e-instruct,
#   llama-3.3-70b-versatile (mais leve/rápido).

# Alternativa gratuita: OpenRouter (modelos open-source com tier free, ex: Qwen2.5 Apache-2.0)
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Produção on-prem (servidor da faculdade, dados nunca saem):
#   vLLM:    LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:32b   (LLM_API_KEY=ollama)

# ── Base de dados ────────────────────────────────────────────────────────────
# POC: SQLite (zero configuração, sem servidor).
DATABASE_URL="file:./dev.db"
# Produção: Postgres → trocar provider em prisma/schema.prisma e usar:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/avalia?schema=public
