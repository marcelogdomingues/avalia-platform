// Avalia — schema de dados (Prisma).
// POC: SQLite (zero configuração). Migrar para Postgres = trocar provider + url;
// os tipos usados (String, Json, Float, DateTime) são portáveis para ambos.
// Multi-tenant: tudo pende de Professor. Isolamento por professorId/courseId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Professor {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  password  String // scrypt: "salt:hash"
  createdAt DateTime @default(now())

  courses Course[]
}

model Course {
  id          String   @id @default(cuid())
  professorId String
  nome        String
  ano         String?
  createdAt   DateTime @default(now())

  professor   Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([professorId])
}

model Assignment {
  id               String   @id @default(cuid())
  courseId         String
  titulo           String
  enunciado        String
  tiposFicheiro    Json // ex: ["pdf","docx","zip"]
  rubrica          Json // [{ id, nome, descricao, peso, pontosMax }]
  instrucoes       String?
  solucaoModelo    String?
  respostaIA       String? // linha-base: resposta que uma IA genérica produz para este enunciado
  feedbackImediato Boolean  @default(false)
  submitToken      String   @unique @default(cuid())
  createdAt        DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
}

model Student {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  numero    String?
  password  String // scrypt: "salt:hash"
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id               String   @id @default(cuid())
  assignmentId     String
  studentId        String?
  alunoNome        String
  alunoEmail       String?
  alunoNumero      String? // para casar com o Moodle no export
  ficheiros        Json // [{ nome, storageKey, mime, tamanho }]
  conteudoExtraido String?
  createdAt        DateTime @default(now())

  assignment Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  evaluation Evaluation?

  @@index([assignmentId])
  @@index([studentId])
}

// estado: PENDENTE | RASCUNHO | APROVADO | ERRO
model Evaluation {
  id             String    @id @default(cuid())
  submissionId   String    @unique
  estado         String    @default("PENDENTE")
  porCriterio    Json? // [{ criterioId, nome, pontos, pontosMax, justificacao }]
  perguntasDefesa Json? // [string] perguntas de verificação oral, específicas à submissão
  feedbackGlobal String?
  notaIA         Float?
  notaFinal      Float?
  modelo         String?
  tokensInput    Int?
  tokensOutput   Int?
  avaliadoEm     DateTime?
  aprovadoEm     DateTime?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
