// Avalia — schema de dados (Prisma).
// POC: SQLite (zero configuração). Migrar para Postgres = trocar provider aqui,
// DATABASE_URL no .env e o driver adapter em lib/db.ts;
// os tipos usados (String, Json, Float, DateTime) são portáveis para ambos.
// Multi-tenant: tudo pende de Professor. Isolamento por professorId/courseId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Professor {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  password  String // scrypt: "salt:hash"
  createdAt DateTime @default(now())

  courses     Course[]
  snippets    CommentSnippet[]
  rubricas    RubricaTemplate[]
  coDocencias CoDocente[]
}

// Co-docência: professores adicionais com acesso a uma cadeira (além do dono).
model CoDocente {
  id          String   @id @default(cuid())
  courseId    String
  professorId String
  criadoEm    DateTime @default(now())

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([courseId, professorId])
  @@index([professorId])
}

// Modelo de rubrica reutilizável do professor.
model RubricaTemplate {
  id          String   @id @default(cuid())
  professorId String
  nome        String
  criterios   Json // [{ nome, descricao, peso, pontosMax }]
  createdAt   DateTime @default(now())

  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
}

// Banco de comentários reutilizáveis do professor (superpoder de correção).
model CommentSnippet {
  id          String   @id @default(cuid())
  professorId String
  atalho      String // etiqueta curta
  texto       String
  usos        Int      @default(0)
  createdAt   DateTime @default(now())

  professor Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@index([professorId])
}

model Course {
  id          String   @id @default(cuid())
  professorId String
  nome        String
  ano         String?
  arquivada   Boolean  @default(false)
  createdAt   DateTime @default(now())

  professor   Professor    @relation(fields: [professorId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  coDocentes  CoDocente[]
  atividade   ActivityLog[]

  @@index([professorId])
}

// Registo de atividade: histórico de ações por cadeira (útil com co-docência).
model ActivityLog {
  id        String   @id @default(cuid())
  courseId  String
  actorNome String // professor que fez a ação
  acao      String // aprovou | reavaliou | avaliacao-manual | convidou | removeu | criou-trabalho | abriu | fechou
  alvo      String? // descrição curta: nome do aluno, título do trabalho, email do colega…
  criadoEm  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, criadoEm])
}

model Assignment {
  id               String   @id @default(cuid())
  courseId         String
  titulo           String
  enunciado        String
  tiposFicheiro    Json // ex: ["pdf","docx","zip"]
  rubrica          Json // [{ id, nome, descricao, peso, pontosMax }]
  instrucoes       String?
  solucaoModelo    String?
  respostaIA       String? // linha-base: resposta que uma IA genérica produz para este enunciado
  testSuite        Json? // autograder: { lang, testFiles:[{path,content}], obrigatorios:"todos"|[nomes] }
  feedbackImediato Boolean  @default(false)
  escala           String   @default("vinte") // vinte|cem|letra|ects|passa — escala de notação
  prazo            DateTime? // data-limite de entrega (opcional)
  politicaAtraso   String   @default("aceitar") // bloquear | aceitar (marca como fora de prazo)
  penalizacaoAtraso Float   @default(0) // % de penalização por dia de atraso (0 = nenhuma)
  grupo            Boolean  @default(false) // permite submissão em grupo (vários membros)
  avaliacaoPares   Boolean  @default(false) // avaliação por pares ativada
  aberto           Boolean  @default(true) // aceita submissões (false = fechado)
  submitToken      String   @unique @default(cuid())
  createdAt        DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
}

model Student {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  numero    String?
  password  String // scrypt: "salt:hash"
  createdAt DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id               String   @id @default(cuid())
  assignmentId     String
  studentId        String?
  alunoNome        String
  alunoEmail       String?
  alunoNumero      String? // para casar com o Moodle no export
  ficheiros        Json // [{ nome, storageKey, mime, tamanho }]
  conteudoExtraido String?
  testResult       Json? // autograder: { total, passed, obrigatoriosTotal, obrigatoriosPassed, gateMet, tests:[{nome,ok,obrigatorio}] }
  respostasDefesa  Json? // [{ pergunta, resposta }] — respostas do aluno à entrevista de defesa
  atrasada         Boolean  @default(false) // entregue depois do prazo
  diasAtraso       Int      @default(0) // dias de atraso (para penalização)
  membros          Json? // [{ nome, numero }] — outros membros do grupo (além do submissor)
  turma            String? // turma/turno do aluno (ex.: "PL2")
  recurso          Json? // { pedido, criadoEm, estado:"aberto"|"respondido", resposta?, respondidoEm? }
  createdAt        DateTime @default(now())

  assignment Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  evaluation Evaluation?

  @@index([assignmentId])
  @@index([studentId])
}

// estado: PENDENTE | RASCUNHO | APROVADO | ERRO
model Evaluation {
  id             String    @id @default(cuid())
  submissionId   String    @unique
  estado         String    @default("PENDENTE")
  porCriterio    Json? // [{ criterioId, nome, pontos, pontosMax, justificacao }]
  perguntasDefesa Json? // [string] perguntas de verificação oral, específicas à submissão
  defesaAvaliacao Json? // { consistencia: 0-100, veredicto, observacoes:[string] } — a IA avalia as respostas de defesa
  deteccaoIA     Json? // { probabilidade: 0-100, indicadores: [string] } — sinal de uso de IA
  feedbackGlobal String?
  notaIA         Float?
  notaFinal      Float?
  modelo         String?
  tokensInput    Int?
  tokensOutput   Int?
  avaliadoEm     DateTime?
  aprovadoEm     DateTime?
  revisorNome    String? // professor que aprovou/editou (relevante com co-docência)
  anotacoes      Json? // [{ trecho, comentario, autor }] comentários em linha do docente

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

// Avaliação por pares: um aluno avalia a submissão de um colega (anonimamente).
model PeerReview {
  id            String   @id @default(cuid())
  assignmentId  String
  revisorSubId  String // submissão de quem avalia
  alvoSubId     String // submissão avaliada
  nota          Float // 0–20
  comentario    String?
  criadoEm      DateTime @default(now())

  @@unique([revisorSubId, alvoSubId])
  @@index([assignmentId])
  @@index([alvoSubId])
}
